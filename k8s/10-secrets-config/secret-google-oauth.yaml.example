apiVersion: v1
kind: Secret
metadata:
  name: google-oauth-secret
  namespace: medplatform
type: Opaque
stringData:
  # PLANTILLA — copia este archivo a "secret-google-oauth.yaml" (que está en .gitignore)
  # y reemplaza con las credenciales reales de Google Cloud Console
  # (APIs y servicios -> Credenciales -> ID de cliente de OAuth 2.0 -> Aplicación web).
  #
  #   Copy-Item secret-google-oauth.yaml.example secret-google-oauth.yaml
  #
  # NO subas el archivo .yaml real al repositorio.
  GOOGLE_CLIENT_ID: "TU_CLIENT_ID.apps.googleusercontent.com"
  GOOGLE_CLIENT_SECRET: "TU_CLIENT_SECRET"
